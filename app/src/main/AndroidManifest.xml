<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET. Not "we promise not to call home" — the OS forbids it. -->
    <!-- Asked once, inside the setup prompt, and only on Android 13+. Declining
         changes nothing: filing runs either way, the notification is just the
         foreground-service receipt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".SiftApp"
        android:label="Sift"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Sift"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sift">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The whole capture surface: any app's Share sheet -> Sift. -->
        <activity
            android:name=".service.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Sift">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
